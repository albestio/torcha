# --- Runtime state (machine-local, written by `torcha init` and its commands) ---
# This repository *is* the tool, so a data directory here is always somebody's
# scratch: never part of the project. Ignore both names whole — listing files
# inside them is how `.agentorch/` ended up in the first public commit, because
# the rename swept the rules to `.torcha/` and left the old directory unmatched.
.torcha/
.agentorch/

# Atomic-write temporaries created by write_json_atomic()
*.tmp
.*.json.*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.whl
*.tar.gz

# --- Release artifacts stay out of version control ---
*.zip

# --- Local reference clones kept for study (never committed) ---
sources/

# --- Local agent tooling caches ---
.atl/

# --- Editors / OS ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# --- Secrets / local environment ---
.env
.env.*
!.env.example

# Dev environment lock: CI installs from pyproject, and a lock nobody updates
# pins yesterday.
uv.lock
