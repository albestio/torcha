# --- Torcha runtime state (machine-local, rewritten by `torcha init`) ---
# The data directory never holds code: it is the shape every target project gets.
.torcha/*.py
.torcha/registry.json
.torcha/last-ls.json
.torcha/bootstrap/
.torcha/logs/
.torcha/state/
.torcha/sessions/
.torcha/handoffs/

# Atomic-write temporaries created by write_json_atomic()
*.tmp
.*.json.*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.whl
*.tar.gz

# --- Release artifacts stay out of version control ---
*.zip

# --- Local reference clones kept for study (never committed) ---
sources/

# --- Local agent tooling caches ---
.atl/

# --- Editors / OS ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# --- Secrets / local environment ---
.env
.env.*
!.env.example

# Dev environment lock: CI installs from pyproject, and a lock nobody updates
# pins yesterday.
uv.lock
